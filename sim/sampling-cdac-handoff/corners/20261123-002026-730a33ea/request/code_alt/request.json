{
 "netlist": "tb.spice",
 "engine": "ngspice",
 "models": {
  "pdk": "sky130A",
  "lib": "libs.tech/combined/sky130.lib.spice"
 },
 "corners": {
  "process": [
   "tt"
  ],
  "supply_v": {
   "vsup": [
    1.8
   ]
  },
  "temperature_c": [
   27.0
  ]
 },
 "analysis_steps": [
  {
   "name": "fast",
   "reset": true,
   "analysis": {
    "kind": "tran",
    "args": "0.2n 250n"
   },
   "measurements": [
    {
     "name": "acq_fast_p",
     "spice": ".meas tran acq_fast_p find v(TOP_P) at=243.433333n",
     "unit": "V"
    },
    {
     "name": "acq_fast_n",
     "spice": ".meas tran acq_fast_n find v(TOP_N) at=243.433333n",
     "unit": "V"
    }
   ]
  },
  {
   "name": "slow",
   "reset": true,
   "analysis": {
    "kind": "tran",
    "args": "0.2n 1040n"
   },
   "measurements": [
    {
     "name": "acq_slow_p",
     "spice": ".meas tran acq_slow_p find v(TOP_P) at=993.433333n",
     "unit": "V"
    },
    {
     "name": "acq_slow_n",
     "spice": ".meas tran acq_slow_n find v(TOP_N) at=993.433333n",
     "unit": "V"
    },
    {
     "name": "acq_late_p",
     "spice": ".meas tran acq_late_p find v(TOP_P) at=1015.000000n",
     "unit": "V"
    },
    {
     "name": "acq_late_n",
     "spice": ".meas tran acq_late_n find v(TOP_N) at=1015.000000n",
     "unit": "V"
    }
   ]
  },
  {
   "name": "tset",
   "reset": true,
   "analysis": {
    "kind": "tran",
    "args": "0.2n 1015n"
   },
   "measurements": [
    {
     "name": "acq_tset",
     "spice": ".meas tran acq_tset TRIG AT=160.1n TARG V(ACQERR) VAL=0.0017578 FALL=LAST",
     "unit": "s"
    }
   ]
  }
 ],
 "options": {
  "timeout_s": 300.0,
  "keep_artifacts": true
 }
}
