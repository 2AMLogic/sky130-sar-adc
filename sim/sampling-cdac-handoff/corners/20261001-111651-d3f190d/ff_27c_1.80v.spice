* sampling-cdac-handoff -- mechanism (d) at the assembled top-plate load (issue #469) -- corner=ff temp=27.0C vdd=1.8V
.lib /home/ubuntu/.volare/sky130A/libs.tech/combined/sky130.lib.spice ff
.temp 27.0

Vdd VDD 0 dc 1.8
Vvss VSS 0 dc 0
Vrefp VREFP 0 dc 1.8
Vrefn VREFN 0 dc 0
Vvcm VCM 0 dc 0.9
Vinp VINP 0 pwl(0n 0.2 130n 0.2 130.2n 1.6 330n 1.6)
Vinn VINN 0 pwl(0n 1.6 130n 1.6 130.2n 0.2 330n 0.2)
Vsample SAMPLE 0 pwl(0n 0 10n 0 10.2n 1.8 110n 1.8 110.2n 0 160n 0 160.2n 1.8 310n 1.8 310.2n 0 330n 0)

* SELp<i>/SELn<i>: ideal DC sources standing in for the SAR
* sequencer's DOUT<i> register held at a fixed previous-conversion
* code throughout both SAMPLE pulses (see module docstring).
Vselp0 SELp0 0 dc 1.8
Vseln0 SELn0 0 dc 0.0
Vselp1 SELp1 0 dc 1.8
Vseln1 SELn1 0 dc 0.0
Vselp2 SELp2 0 dc 1.8
Vseln2 SELn2 0 dc 0.0
Vselp3 SELp3 0 dc 1.8
Vseln3 SELn3 0 dc 0.0
Vselp4 SELp4 0 dc 1.8
Vseln4 SELn4 0 dc 0.0
Vselp5 SELp5 0 dc 1.8
Vseln5 SELn5 0 dc 0.0
Vselp6 SELp6 0 dc 1.8
Vseln6 SELn6 0 dc 0.0
Vselp7 SELp7 0 dc 1.8
Vseln7 SELn7 0 dc 0.0
Vselp8 SELp8 0 dc 1.8
Vseln8 SELn8 0 dc 0.0

