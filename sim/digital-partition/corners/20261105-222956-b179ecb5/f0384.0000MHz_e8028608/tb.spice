* --- behavioural monitors (high impedance; they load nothing) ---
.func h(x) '0.5*(1+tanh(((x)-0.5*v(VPWR))/0.05))'
BPCODE PCODE 0 V = 1*h(v(PH_SAMPLE)) + 2*h(v(PH_B9)) + 4*h(v(PH_B8)) + 8*h(v(PH_B7)) + 16*h(v(PH_B6)) + 32*h(v(PH_B5)) + 64*h(v(PH_B4)) + 128*h(v(PH_B3)) + 256*h(v(PH_B2)) + 512*h(v(PH_B1)) + 1024*h(v(PH_B0)) + 2048*h(v(PH_EOC))
BCTL CTLCODE 0 V = 1*h(v(BUSY)) + 2*h(v(HALF_LSB_EN)) + 4*h(v(HALF_LSB_ENN))
BDCODE DCODE 0 V = 1*h(v(DOUT0)) + 2*h(v(DOUT1)) + 4*h(v(DOUT2)) + 8*h(v(DOUT3)) + 16*h(v(DOUT4)) + 32*h(v(DOUT5)) + 64*h(v(DOUT6)) + 128*h(v(DOUT7)) + 256*h(v(DOUT8)) + 512*h(v(DOUT9))
BADC ADCCODE 0 V = 1*h(v(ADCOUT0)) + 2*h(v(ADCOUT1)) + 4*h(v(ADCOUT2)) + 8*h(v(ADCOUT3)) + 16*h(v(ADCOUT4)) + 32*h(v(ADCOUT5)) + 64*h(v(ADCOUT6)) + 128*h(v(ADCOUT7)) + 256*h(v(ADCOUT8))
BSELN SELNCODE 0 V = 1*h(v(SELn0)) + 2*h(v(SELn1)) + 4*h(v(SELn2)) + 8*h(v(SELn3)) + 16*h(v(SELn4)) + 32*h(v(SELn5)) + 64*h(v(SELn6)) + 128*h(v(SELn7)) + 256*h(v(SELn8))
BSELP SELPCODE 0 V = 1*h(v(SELp0)) + 2*h(v(SELp1)) + 4*h(v(SELp2)) + 8*h(v(SELp3)) + 16*h(v(SELp4)) + 32*h(v(SELp5)) + 64*h(v(SELp6)) + 128*h(v(SELp7)) + 256*h(v(SELp8))
