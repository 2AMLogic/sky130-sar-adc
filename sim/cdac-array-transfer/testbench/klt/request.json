      "unit": "V"
    },
    {
      "name": "vtop_p_511",
      "spice": ".meas tran vtop_p_511 FIND v(top_511p) AT=500n",
      "unit": "V"
    },
    {
      "name": "vtop_n_511",
      "spice": ".meas tran vtop_n_511 FIND v(top_511n) AT=500n",
      "unit": "V"
    }
